LLM_PROVIDER=ollama
# Must match a tag you have actually pulled (`ollama list`). Quantized builds
# carry a suffix, e.g. qwen2.5:7b-instruct-q4_K_M; the plain tag then 404s.
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

EMBEDDING_MODEL=intfloat/multilingual-e5-base
DATA_DIR=./data
STORAGE_DIR=./storage
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
TOP_K=5
# Confidence gate: both thresholds must be cleared. Calibrated against the demo
# question set in Task 9 — see MEMORY.md for the measured score distribution.
MIN_COSINE=0.80
MIN_BM25=5.0
MAX_TOOL_TURNS=3
