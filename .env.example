LLM_PROVIDER=ollama
# Temellendirilmiş soru-cevapta örnekleme kapalı olmalı. Ollama varsayılanı 0.8
# ve o değerde model aynı istemde bazen [n] atıf işaretini atlıyor; atıf kapısı
# da doğru cevabı eliyor. 0 = tekrarlanabilir çıktı.
LLM_TEMPERATURE=0
# CPU'da 7B model, bağlamda kaynak metinleri varken 120 sn'yi aşıyor.
LLM_TIMEOUT_SECONDS=600
# Must match a tag you have actually pulled (`ollama list`). Quantized builds
# carry a suffix, e.g. qwen2.5:7b-instruct-q4_K_M; the plain tag then 404s.
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# Bulut sağlayıcı anahtarları. Bunlar CLI/Docker için yedektir; arayüzden
# girilen anahtarlar yalnız oturum belleğinde tutulur ve buraya yazılmaz.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model indirme uzun sürebilir (4-5 GB)
OLLAMA_PULL_TIMEOUT=3600

EMBEDDING_MODEL=intfloat/multilingual-e5-base
DATA_DIR=./data
STORAGE_DIR=./storage
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
TOP_K=5
# Confidence gate: both thresholds must be cleared. Calibrated against the demo
# question set in Task 9 — see MEMORY.md for the measured score distribution.
MIN_COSINE=0.80
MIN_BM25=5.0
MAX_TOOL_TURNS=3
