# Azure OpenAI — the key comes from a Container Apps secret in production
AZURE_OPENAI_ENDPOINT=https://foundry-lab-hbc26.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Retrieval gate — MEASURED in Task 8, do not invent values.
# Prefixed AZURE_ to avoid colliding with src/rag/config.py, which reads the
# same unprefixed names from the same process environment.
AZURE_MIN_COSINE=0.25
AZURE_MIN_BM25=4.22

# Tier-to-tier authentication
INTERNAL_TOKEN=

AZURE_DATA_DIR=./data
AZURE_STORAGE_DIR=./azure/storage
